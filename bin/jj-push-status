#!/usr/bin/env bash
# Prompt indicator for whether @ is pushed to the "origin" remote.
#   ▲N  (yellow) — N non-empty changes ahead of origin (unpushed work)
#   ☁   (green)  — an origin bookmark is in @'s ancestry and nothing is ahead
# Prints nothing outside a jj repo or when no origin bookmark is reachable, so
# it's safe to run unconditionally from the prompt.
set -euo pipefail

# The colocated ".git" shows up as a "git" remote; only "origin" is the real one.
origin='remote_bookmarks(remote=exact:"origin")'

count() {
  jj log --no-pager --ignore-working-copy --no-graph -r "$1" -T '"."' 2>/dev/null | tr -d '\n' | wc -c | tr -d ' '
}

# Bail quietly if this isn't a jj repo.
jj root --ignore-working-copy >/dev/null 2>&1 || exit 0

ahead=$(count "${origin}..@ & ~empty()")

yellow=$'\e[33m'; green=$'\e[32m'; reset=$'\e[0m'

if [ "${ahead:-0}" -gt 0 ]; then
  printf '%s▲%s%s' "$yellow" "$ahead" "$reset"
elif [ "$(count "${origin} & ::@")" -gt 0 ]; then
  printf '%s☁%s' "$green" "$reset"
fi
