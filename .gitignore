.DS_Store
**/automatic_backups/**

# Generated per-machine zsh completion cache (zsh version / fpath specific)
.zcompdump
.zcompdump*

# The global gitignore excludes .claude/ everywhere. Re-include the package dir,
# re-ignore its contents, then track only the two hand-owned files (skills and
# other generated state stay untracked).
!config/claude/.claude/
config/claude/.claude/*
!config/claude/.claude/CLAUDE.md
!config/claude/.claude/settings.json

erl_crash.dump
