{
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "npm:@plannotator/pi-extension",
    {
      "source": "~/.config/nono/packages/nolabs-ai/pi"
    },
    {
      "source": "git:github.com/mattpocock/skills",
