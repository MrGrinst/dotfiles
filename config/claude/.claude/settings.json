{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-8",
  "modelSettings": {
    "claude-opus-4-8": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "editorMode": "normal",
  "enableArtifact": false,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "dialogExpiry": "never",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "voice": {
    "enabled": false
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); used=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // empty'); pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ] && [ -n \"$pct\" ]; then k=$(( (used + 500) / 1000 )); pct_fmt=$(printf '%.0f' \"$pct\"); if [ \"$used\" -ge 120000 ]; then color='\\033[31m'; elif [ \"$used\" -ge 80000 ]; then color='\\033[33m'; else color='\\033[37m'; fi; printf \"${color}%sk (%s%%)\\033[0m\" \"$k\" \"$pct_fmt\"; else printf '\\033[2mn/a\\033[0m'; fi"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/biome-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then tty=$(tmux display-message -p -t \"$TMUX_PANE\" '#{pane_tty}') && printf '\\a' > \"$tty\"; else printf '\\a' > /dev/tty 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.scripts[\"format:write\"] and .scripts[\"lint:fix\"]' package.json >/dev/null 2>&1 && pnpm format:write && pnpm lint:fix || true",
            "timeout": 180,
            "statusMessage": "Running pnpm format:write & lint:fix..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "directory",
        "path": "/Users/kylegrinstead/Developer/plannotator"
      }
    }
  }
}
